# DISHA — Environment Configuration Template
# Copy this file to ".env" in the project root and populate with your own values.
# NEVER commit the real ".env" file to GitHub or any public repository.

# AI & Reasoning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Global Hotkeys
DISHA_HOTKEY=<ctrl>+<alt>+d
DISHA_VOICE_HOTKEY=<ctrl>+<alt>+v

# Voice & Speech-to-Text
DISHA_STT_ENGINE=whisper
DISHA_WHISPER_MODEL=small.en
DISHA_TTS_ENABLED=true
DISHA_TTS_ENGINE=neural
DISHA_TTS_NEURAL_VOICE=en-US-AnaNeural
DISHA_TTS_RATE=175
DISHA_TTS_VOICE=female

# Hands-Free Wake Word
DISHA_WAKE_WORD=false
DISHA_WAKE_PHRASE=hey disha

# User Profile
USER_NAME=YourName

# Remote Mobile Web Companion
DISHA_WEB_ENABLED=false
DISHA_WEB_HOST=0.0.0.0
DISHA_WEB_PORT=5000
DISHA_WEB_TOKEN=your_secure_bearer_token_here

# USB Portable Mode
DISHA_USB_MODE=false

# Offline Local LLM (Ollama)
DISHA_OLLAMA_MODEL=llama3.2:3b
DISHA_OLLAMA_URL=http://localhost:11434/api/generate
